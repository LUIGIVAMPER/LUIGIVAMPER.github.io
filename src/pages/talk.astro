---
import Base from '../layouts/Base.astro';
import { talk } from '../data/talk';

const n = talk.slides.length;
---

<Base title={`${talk.title} · Jianwen Lyu`} description={talk.subtitle}>
  <article class="wrap page">
    <p><a href="/#research">← Back to research</a></p>

    <header>
      <p class="eyebrow">Research slides · {n} slides</p>
      <h1>{talk.title}</h1>
      <p class="subtitle">{talk.subtitle}</p>
      <div class="btn-row">
        <a class="btn primary" href={talk.pdf}>Open PDF (with links)</a>
      </div>
    </header>

    <section class="viewer" aria-roledescription="carousel" aria-label="Slides" data-viewer>
      <div class="stage">
        {
          talk.slides.map((s, i) => (
            <figure class="slide" data-slide hidden={i !== 0} aria-roledescription="slide" aria-label={`${i + 1} of ${n}`}>
              <img
                src={s.src}
                alt={`Slide ${i + 1}: ${s.title}`}
                width="1920"
                height="1080"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            </figure>
          ))
        }
      </div>

      <div class="controls">
        <button type="button" class="btn" data-prev aria-label="Previous slide">←</button>
        <p class="counter" aria-live="polite">
          <span data-index>1</span> / {n} · <span data-title>{talk.slides[0].title}</span>
        </p>
        <button type="button" class="btn" data-next aria-label="Next slide">→</button>
      </div>

      <ol class="thumbs">
        {
          talk.slides.map((s, i) => (
            <li>
              <button type="button" data-goto={i} aria-label={`Go to slide ${i + 1}: ${s.title}`} aria-current={i === 0 ? 'true' : undefined}>
                <img src={s.src} alt="" loading="lazy" width="192" height="108" />
                <span>{i + 1}</span>
              </button>
            </li>
          ))
        }
      </ol>
      <p class="hint">Tip: use ← / → keys or swipe.</p>
    </section>
  </article>
</Base>

<script is:inline data-titles={JSON.stringify(talk.slides.map((s) => s.title))}>
  (() => {
    const root = document.querySelector('[data-viewer]');
    if (!root) return;
    const titles = JSON.parse(document.currentScript.dataset.titles);
    const slides = [...root.querySelectorAll('[data-slide]')];
    const thumbs = [...root.querySelectorAll('[data-goto]')];
    const idxEl = root.querySelector('[data-index]');
    const titleEl = root.querySelector('[data-title]');
    let cur = 0;

    function go(i, updateHash = true) {
      cur = (i + slides.length) % slides.length;
      slides.forEach((s, k) => (s.hidden = k !== cur));
      thumbs.forEach((t, k) => (k === cur ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      idxEl.textContent = String(cur + 1);
      titleEl.textContent = titles[cur];
      thumbs[cur].scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      if (updateHash) history.replaceState(null, '', `#${cur + 1}`);
    }

    root.querySelector('[data-prev]').addEventListener('click', () => go(cur - 1));
    root.querySelector('[data-next]').addEventListener('click', () => go(cur + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.goto))));
    document.addEventListener('keydown', (e) => {
      if (e.target.closest('input, textarea')) return;
      if (e.key === 'ArrowRight' || e.key === 'PageDown') go(cur + 1);
      if (e.key === 'ArrowLeft' || e.key === 'PageUp') go(cur - 1);
    });

    let x0 = null;
    const stage = root.querySelector('.stage');
    stage.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) go(cur + (dx < 0 ? 1 : -1));
      x0 = null;
    });

    const start = parseInt(location.hash.slice(1), 10);
    if (start >= 1 && start <= slides.length) go(start - 1, false);
  })();
</script>

<style>
  .page {
    padding-block: 2.5rem 4rem;
  }

  header {
    margin: 1.5rem 0 2rem;
  }

  h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
    margin-top: 0.3rem;
  }

  .subtitle {
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0.3rem 0 1rem;
  }

  .stage {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    aspect-ratio: 16 / 9;
    touch-action: pan-y;
  }

  .slide {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.9rem 0;
  }

  .controls .btn {
    font-size: 1.1rem;
    padding: 0.35em 1em;
    cursor: pointer;
  }

  .counter {
    margin: 0;
    text-align: center;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .thumbs {
    list-style: none;
    padding: 0.25rem 0 0.5rem;
    margin: 0;
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
  }

  .thumbs button {
    position: relative;
    display: block;
    width: 8.5rem;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
    cursor: pointer;
    opacity: 0.65;
  }

  .thumbs button:hover,
  .thumbs button[aria-current='true'] {
    opacity: 1;
  }

  .thumbs button[aria-current='true'] {
    border-color: var(--accent);
  }

  .thumbs img {
    width: 100%;
    height: auto;
  }

  .thumbs span {
    position: absolute;
    left: 0.3rem;
    bottom: 0.25rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    padding: 0 0.3rem;
    border-radius: 3px;
  }

  .hint {
    font-size: 0.82rem;
    color: var(--faint);
    margin-top: 0.5rem;
  }
</style>
