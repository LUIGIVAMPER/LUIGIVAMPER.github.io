---
import { getCollection } from 'astro:content';
import { arc } from '../data/profile';

const projects = await getCollection('projects');
const titleOf = (id: string) => projects.find((p) => p.id === id)?.data.title ?? id;
---

<ol class="arc" aria-label="Research arc">
  {
    arc.map((s) => (
      <li class:list={['step', { future: s.future }]}>
        <div class="step-top">
          <span class="num">{s.step}</span>
          <h3>{s.title}</h3>
          {s.future && <span class="badge future">Future direction</span>}
        </div>
        <p>{s.question}</p>
        <p class="refs">
          {s.projects.length > 0
            ? s.projects.map((id, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={`#project-${id}`}>{titleOf(id)}</a>
                </>
              ))
            : <a href="#interests">See research interests</a>}
        </p>
      </li>
    ))
  }
</ol>

<style>
  .arc {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    counter-reset: none;
  }

  .step {
    position: relative;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .step:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -0.85rem;
    top: 1.1rem;
    color: var(--faint);
    font-size: 1rem;
    background: var(--bg);
    line-height: 1;
    padding: 0.1rem 0;
  }

  .step.future {
    border-style: dashed;
    border-color: var(--future);
    background: transparent;
  }

  .step-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .num {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--faint);
  }

  h3 {
    font-size: 1.15rem;
  }

  .step p {
    font-size: 0.92rem;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }

  .refs {
    font-size: 0.88rem;
    font-weight: 500;
    margin: 0 !important;
  }

  @media (max-width: 44rem) {
    .arc {
      grid-template-columns: 1fr;
    }
    .step:not(:last-child)::after {
      content: '↓';
      right: auto;
      left: 1.2rem;
      top: auto;
      bottom: -0.85rem;
      padding: 0 0.2rem;
    }
  }
</style>
