---
import { interests, additionalInterests } from '../data/profile';
---

<section id="interests" class="section">
  <div class="wrap">
    <div class="section-head">
      <h2>Research Interests</h2>
    </div>
    <p class="lede">
      Three connected questions: first understanding the physical structure that makes an action feasible, then acting reliably under it, and finally adapting when that understanding turns out to be wrong.
    </p>

    <ol class="interests">
      {
        interests.map((it, i) => (
          <li class:list={{ future: i === 2 }}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{it.title}</h3>
              <p>{it.question}</p>
              <p class="related">{it.related}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="extra"><span class="label">Also interested in:</span> {additionalInterests}</p>
  </div>
</section>

<style>
  .interests {
    list-style: none;
    padding: 0;
    margin: 2rem 0 1.5rem;
    display: grid;
    gap: 1.5rem;
  }

  li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.75rem;
  }

  .num {
    font-family: var(--mono);
    color: var(--accent);
    padding-top: 0.25rem;
  }

  li.future .num,
  li.future .related {
    color: var(--future);
  }

  h3 {
    font-size: 1.2rem;
    margin-bottom: 0.35rem;
  }

  li p {
    margin-bottom: 0.3rem;
    max-width: 44rem;
  }

  .related {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
  }

  .extra {
    font-size: 0.92rem;
    color: var(--muted);
  }

  .label {
    font-weight: 600;
    color: var(--fg);
  }
</style>
